    "@types/react-dom": "^19.2.1",
    "@types/react-transition-group": "^4.4.12",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.31",
    "prettier": "^3.6.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
